# Database. Locally: an embedded SQLite file, created by `npm run setup`.
# Hosted (Vercel): libsql://<database>-<org>.turso.io and a Turso auth token.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Optional: freeze "now" (ISO 8601 with offset). Empty = real Moscow time.
# Example used by the acceptance criteria: 2026-10-19T10:00:00+03:00
APP_NOW=

# RATE_LIMIT_DISABLED=1 turns off the request rate limiter. End-to-end tests only (playwright.config.ts sets it).
# Never set it in production (Vercel): it removes the protection against flooding the chat and session APIs.

